<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="stylesheet" href="/styles.css" />
    <title>Rune-amabot</title>
  </head>
  <body>
    <header>
      <h1>Rune-amabot</h1>
      <p>Spørg mig om alt!</p>
    </header>

    <main>
      <section class="chat" aria-label="Chatbot">
        <!-- Beskedhistorik -->
        <div
          class="messages"
          role="log"
          aria-live="polite"
          aria-label="Chat historik"
        >
          <article class="answer">
            <p>Hej! Spørg mig om hvad som helst!</p>
          </article>

          <% for (const message of messages) { %>
            <article class="<%= message.type %>">
              <time><%= message.createdAt.toLocaleTimeString("da-DK") %></time>
              <p><%= message.text %></p>
            </article>
          <% } %>
        </div>

        <!-- Input-område -->
        <form class="chat-input" method="post" action="/ask">
          <label for="question">Skriv din besked</label>
          <input
            id="question"
            name="question"
            type="text"
            placeholder="Skriv en besked..."
            required
          />
          <button type="submit">Send</button>
        </form>
        <form method="POST" action="/clear-messages">
  <button type="submit">Ryd beskeder</button>
</form>
        <% if (error) { %>
  <p role="alert"><%= error %></p>
<% } %>
        <% if (error) { %>
  <p role="alert"><%= error %></p>
<% } %>

        <div class="stats">
          <p>Navn: <%= topicStats.navn %></p>
          <p>Bosted: <%= topicStats.bosted %></p>
          <p>Fritid: <%= topicStats.fritid %></p>
        </div>
      </section>
      </section>
    </main>

    <footer>
      <p>Lavet af Rune</p>
    </footer>
  </body>
</html>