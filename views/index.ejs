<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="stylesheet" href="/styles.css" />
    <title>Rune-amabot</title>
  </head>
  <body>
    <header>
  <h1 data-text="Rune-amabot">Rune-amabot</h1>
</header>

<main>
  <section class="chat" aria-label="Chatbot">
    <div class="chat-toolbar">
      <form method="POST" action="/clear-messages">
        <button type="submit" class="icon-btn" aria-label="Ny chat">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
            <line x1="12" y1="5" x2="12" y2="19" />
            <line x1="5" y1="12" x2="19" y2="12" />
          </svg>
        </button>
      </form>
    </div>
    <!-- Beskedhistorik -->
        <div
          class="messages"
          role="log"
          aria-live="polite"
          aria-label="Chat historik"
        >
          <article class="answer">
            <p>Hej! Spørg mig om hvad som helst!</p>
          </article>

          <% for (const message of messages) { %>
  <article class="<%= message.type %>">
  <time><%= new Date(message.createdAt).toLocaleTimeString("da-DK", { hour: "2-digit", minute: "2-digit" }) %></time>
  <p><%= message.text %></p>
</article>
<% } %>
        </div>

        <!-- Input-område -->
        <form class="chat-input" method="post" action="/ask">
  <label for="question">Skriv din besked</label>
  <input
    id="question"
    name="question"
    type="text"
    placeholder="Skriv en besked..."
    required
    maxlength="280"
  />
  <button type="submit" id="send-btn" disabled>Send</button>
</form>
<p id="char-counter" class="char-counter">0/280</p>
        
        <% if (error) { %>
  <p role="alert"><%= error %></p>
<% } %>

        <div class="stats">
          <p>Navn: <%= topicStats.navn %></p>
          <p>Bosted: <%= topicStats.bosted %></p>
          <p>Fritid: <%= topicStats.fritid %></p>
        </div>
      </section>
      
    </main>

    <footer>
      <p>Lavet af Rune</p>
    </footer>
    <script src="/chat.js" defer></script>
  </body>
</html>